---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import PeptideInfoExperience from "../components/shop/PeptideInfoExperience.jsx";
import "../styles/global.css";

const siteUrl = Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const seoTitle = "Qué son los péptidos: guía de investigación | LAB_CORE Colombia";
const seoDescription = "Guía en español sobre estructura, síntesis, calidad analítica y lectura de COA de péptidos como BPC-157, MOTS-c, CJC-1295 y tesamorelina.";
const guideSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Guía de péptidos para investigación de LAB_CORE Colombia",
  description: seoDescription,
  url: canonicalURL,
  author: { "@type": "Organization", name: "LAB_CORE" },
  publisher: { "@type": "Organization", name: "LAB_CORE" },
  inLanguage: "es-CO",
  about: ["Peptide chemistry", "Peptide synthesis", "Certificates of Analysis", "HPLC", "LC-MS", "Research peptide directory", "Research quality"],
};
---

<BaseLayout title={seoTitle} description={seoDescription} canonical={canonicalURL}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <script type="application/ld+json" set:html={JSON.stringify(guideSchema)} />
  </Fragment>

  <PeptideInfoExperience client:idle />
</BaseLayout>
