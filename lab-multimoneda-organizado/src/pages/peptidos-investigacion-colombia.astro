---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import PeptidesColombiaExperience, { faqs } from "../components/seo/PeptidesColombiaExperience.jsx";

const canonical = "https://labcorepep.com/peptidos-investigacion-colombia";
const title = "Péptidos de investigación en Colombia con COA | LAB_CORE";
const description = "Guía y catálogo de péptidos para investigación de laboratorio en Colombia. Aprende a revisar identidad, pureza, trazabilidad y certificados de análisis por lote.";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: "es-CO",
    isPartOf: { "@id": "https://labcorepep.com/#website" },
    about: [
      { "@type": "Thing", name: "Péptidos de investigación" },
      { "@type": "Thing", name: "Certificados de análisis" },
      { "@type": "Country", name: "Colombia" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: "https://labcorepep.com/" },
      { "@type": "ListItem", position: 2, name: "Péptidos de investigación en Colombia", item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} imageAlt="Guía de péptidos de investigación en Colombia de LAB_CORE">
  <Fragment slot="head">
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </Fragment>
  <PeptidesColombiaExperience client:idle />
</BaseLayout>
