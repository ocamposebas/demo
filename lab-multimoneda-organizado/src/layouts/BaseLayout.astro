---
import '../styles/global.css';
import AgeGate from '../components/ui/AgeGate.astro';

const {
  title = 'Péptidos de investigación en Colombia | LAB_CORE',
  description = 'Péptidos y compuestos para investigación de laboratorio en Colombia, con información técnica, trazabilidad por lote y certificados de análisis.',
  url,
  canonical,
  image = '/INICIO.png',
  imageAlt = 'LAB_CORE Colombia — péptidos y compuestos para investigación',
} = Astro.props;

const toSiteBase = (value) => {
  if (!value) return null;

  try {
    const input = String(value).trim();

    const parsed = new URL(
      /^https?:\/\//i.test(input)
        ? input
        : `https://${input}`,
    );

    if (!['http:', 'https:'].includes(parsed.protocol)) {
      return null;
    }

    parsed.pathname = '/';
    parsed.search = '';
    parsed.hash = '';

    return parsed;
  } catch {
    return null;
  }
};

const isLoopback = (site) =>
  ['localhost', '127.0.0.1', '::1'].includes(site?.hostname);

const configuredSite = [
  import.meta.env.PUBLIC_SITE_URL,
  import.meta.env.SITE_URL,
  Astro.site?.toString(),
  url,
]
  .map(toSiteBase)
  .find((site) => site && !isLoopback(site));

const siteBase = configuredSite || new URL(Astro.url.origin);

const toAbsoluteURL = (value, fallbackPath) => {
  try {
    const parsed = new URL(value || fallbackPath, siteBase);

    if (!['http:', 'https:'].includes(parsed.protocol)) {
      throw new Error('Unsupported URL protocol');
    }

    return parsed;
  } catch {
    return new URL(fallbackPath, siteBase);
  }
};

const requestedCanonicalURL = toAbsoluteURL(
  canonical,
  Astro.url.pathname,
);

/**
 * Mantiene el dominio de producción configurado,
 * aunque una página suministre un canonical relativo.
 */
const canonicalURL = configuredSite
  ? new URL(
      `${requestedCanonicalURL.pathname}${requestedCanonicalURL.search}`,
      siteBase,
    )
  : requestedCanonicalURL;

canonicalURL.search = '';
canonicalURL.hash = '';

const socialImageURL = toAbsoluteURL(image, '/INICIO.png');
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', siteBase).toString(),
  name: 'LAB_CORE',
  alternateName: ['LAB CORE', 'LAB_CORE Colombia'],
  url: siteBase.toString(),
  logo: {
    '@type': 'ImageObject',
    url: new URL('/brand-mark.svg', siteBase).toString(),
  },
  image: socialImageURL.toString(),
  description:
    'Proveedor de péptidos y compuestos destinados exclusivamente a investigación de laboratorio, con documentación analítica y trazabilidad por lote.',
  areaServed: {
    '@type': 'Country',
    name: 'Colombia',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', siteBase).toString(),
  url: siteBase.toString(),
  name: 'LAB_CORE Colombia',
  alternateName: 'LAB_CORE',
  inLanguage: ['es-CO', 'en'],
  publisher: { '@id': organizationSchema['@id'] },
};
---

<!doctype html>

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta name="theme-color" content="#020617" />
    <meta name="generator" content={Astro.generator} />
    <meta name="geo.region" content="CO" />
    <meta name="geo.placename" content="Colombia" />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <!-- SEO básico -->
    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonicalURL.toString()}
    />
    <link rel="alternate" hreflang="es-CO" href={canonicalURL.toString()} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL.toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LAB_CORE" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={title} />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:image"
      content={socialImageURL.toString()}
    />

    <meta
      property="og:image:alt"
      content={imageAlt}
    />

    <!-- Twitter / X -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:url"
      content={canonicalURL.toString()}
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImageURL.toString()}
    />

    <meta
      name="twitter:image:alt"
      content={imageAlt}
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Google Fonts -->
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Allura&family=Orbitron:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- Contenido adicional enviado por las páginas -->
    <slot name="head" />

    <!-- Omnisend -->
    <script is:inline>
      (() => {
        if (window.__labcoreOmnisendInitialized) return;

        window.__labcoreOmnisendInitialized = true;
        window.omnisend = window.omnisend || [];

        const getPageKey = () =>
          `${window.location.pathname}${window.location.search}`;

        window.omnisend.push([
          'brandID',
          '6a5fddd7be02584b6a42166e',
        ]);

        window.omnisend.push(['track', '$pageViewed']);

        window.__labcoreLastOmnisendPage = getPageKey();

        const script = document.createElement('script');

        script.type = 'text/javascript';
        script.async = true;
        script.src =
          'https://omnisnippet1.com/inshop/launcher-v2.js';

        const firstScript =
          document.getElementsByTagName('script')[0];

        firstScript.parentNode.insertBefore(
          script,
          firstScript,
        );

        /*
         * Registra cambios de página cuando Astro utiliza
         * navegación del lado del cliente.
         */
        document.addEventListener('astro:page-load', () => {
          const currentPage = getPageKey();

          if (
            window.__labcoreLastOmnisendPage === currentPage
          ) {
            return;
          }

          window.omnisend.push(['track', '$pageViewed']);
          window.__labcoreLastOmnisendPage = currentPage;
        });
      })();
    </script>

    <!-- Meta Pixel -->
    <script is:inline>
      (() => {
        const META_PIXEL_ID = '1392617929673853';

        if (window.__labcoreMetaPixelInitialized) return;

        window.__labcoreMetaPixelInitialized = true;

        !function (f, b, e, v, n, t, s) {
          if (f.fbq) return;

          n = f.fbq = function () {
            n.callMethod
              ? n.callMethod.apply(n, arguments)
              : n.queue.push(arguments);
          };

          if (!f._fbq) f._fbq = n;

          n.push = n;
          n.loaded = true;
          n.version = '2.0';
          n.queue = [];

          t = b.createElement(e);
          t.async = true;
          t.src = v;

          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        }(
          window,
          document,
          'script',
          'https://connect.facebook.net/en_US/fbevents.js',
        );

        const getPageKey = () =>
          `${window.location.pathname}${window.location.search}`;

        window.fbq('init', META_PIXEL_ID);
        window.fbq('track', 'PageView');

        window.__labcoreLastMetaPage = getPageKey();

        /*
         * Evita duplicar el PageView inicial y registra
         * futuras navegaciones realizadas por ClientRouter.
         */
        document.addEventListener('astro:page-load', () => {
          const currentPage = getPageKey();

          if (window.__labcoreLastMetaPage === currentPage) {
            return;
          }

          window.fbq?.('track', 'PageView');
          window.__labcoreLastMetaPage = currentPage;
        });
      })();
    </script>
    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-18349498409"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-18349498409');
</script>
    <!-- End Meta Pixel -->
  </head>

  <body
    class="bg-[#020617] text-slate-300 min-h-screen overflow-x-hidden selection:bg-cyan-500 selection:text-black"
  >
    <!-- Meta Pixel: respaldo para navegadores sin JavaScript -->
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1392617929673853&ev=PageView&noscript=1"
        alt=""
      />
    </noscript>

    <AgeGate />

    <!-- Fondo cuadriculado -->
    <div
      class="fixed inset-0 z-[-1] opacity-20 pointer-events-none"
      style="background-image: radial-gradient(#1e293b 1px, transparent 1px); background-size: 40px 40px;"
      aria-hidden="true"
    >
    </div>

    <!-- Luz ambiental -->
    <div
      class="fixed top-[-10%] left-[-10%] w-[50%] h-[50%] bg-cyan-500/5 blur-[140px] rounded-full pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <slot />
  </body>
</html>
