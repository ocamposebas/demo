<script is:inline>
  (() => {
    const gate = document.getElementById("lab-age-gate");
    if (!gate) return;

    const copy = {
      es: {
        restricted: "ACCESO PARA MAYORES DE 21 AÑOS",
        title: "Confirma tu edad",
        subtitle: "Este sitio ofrece materiales destinados exclusivamente a investigación de laboratorio.",
        question: "Confirma que tienes 21 años o más para continuar. Los productos no son para uso humano ni veterinario.",
        confirm: "Sí, tengo 21 años o más",
        deny: "No cumplo con la edad requerida",
        accountInviteTitle: "Crea tu cuenta y obtén 10%",
        accountInviteText: "Guarda tus pedidos y activa tu beneficio de bienvenida.",
        accountInviteAction: "Crear cuenta",
        remember: "Recordaremos esta confirmación durante 30 días en este dispositivo.",
        back: "Volver",
        welcomeBenefit: "BENEFICIO DE BIENVENIDA",
        registerTitle: "Crea tu cuenta",
        registerIntro: "Regístrate para guardar tus pedidos y recibir un cupón personal del 10% para tu primera compra.",
        firstName: "Nombre",
        lastName: "Apellido",
        email: "Correo electrónico",
        password: "Contraseña",
        passwordHint: "Mínimo 10 caracteres.",
        consent: "Confirmo que tengo 21 años o más, que los productos son solo para investigación y que acepto los",
        terms: "Términos y condiciones",
        registerSubmit: "Crear cuenta y obtener 10%",
        registerBusy: "Creando tu cuenta…",
        requiredStatus: "Completa todos los campos obligatorios.",
        invalidEmailStatus: "Escribe un correo electrónico válido.",
        passwordStatus: "La contraseña debe tener al menos 10 caracteres.",
        consentStatus: "Debes confirmar que tienes 21 años o más y aceptar los términos.",
        registerSuccess: "Cuenta creada. Estamos abriendo tu cuenta…",
        emailExistsError: "Ya existe una cuenta con este correo. Puedes iniciar sesión desde Mi cuenta.",
        invalidRegistrationError: "Revisa los datos del formulario e inténtalo de nuevo.",
        rateLimitedError: "Demasiados intentos. Espera unos minutos y vuelve a probar.",
        accountUnavailableError: "El servicio de cuenta no está disponible en este momento. Inténtalo más tarde.",
        registerError: "No pudimos crear tu cuenta. Inténtalo nuevamente.",
        deniedTitle: "Acceso no autorizado",
        deniedText: "No puedes continuar porque el sitio está reservado para personas de 21 años o más.",
        review: "Revisar mi respuesta",
        footer: "Solo investigación de laboratorio · No apto para uso humano ni veterinario",
      },
      en: {
        restricted: "ACCESS FOR PEOPLE 21 AND OVER",
        title: "Confirm your age",
        subtitle: "This site offers materials intended exclusively for laboratory research.",
        question: "Confirm that you are 21 or older to continue. Products are not for human or veterinary use.",
        confirm: "Yes, I am 21 or older",
        deny: "I do not meet the age requirement",
        accountInviteTitle: "Create an account and get 10% off",
        accountInviteText: "Save your orders and activate your welcome benefit.",
        accountInviteAction: "Create account",
        remember: "We will remember this confirmation for 30 days on this device.",
        back: "Back",
        welcomeBenefit: "WELCOME BENEFIT",
        registerTitle: "Create your account",
        registerIntro: "Register to save your orders and receive a personal 10% coupon for your first purchase.",
        firstName: "First name",
        lastName: "Last name",
        email: "Email address",
        password: "Password",
        passwordHint: "At least 10 characters.",
        consent: "I confirm that I am 21 or older, that the products are for research only, and that I accept the",
        terms: "Terms and Conditions",
        registerSubmit: "Create account and get 10% off",
        registerBusy: "Creating your account…",
        requiredStatus: "Complete all required fields.",
        invalidEmailStatus: "Enter a valid email address.",
        passwordStatus: "Your password must contain at least 10 characters.",
        consentStatus: "You must confirm that you are 21 or older and accept the terms.",
        registerSuccess: "Account created. We are opening your account…",
        emailExistsError: "An account already exists for this email. You can sign in from My Account.",
        invalidRegistrationError: "Review the form details and try again.",
        rateLimitedError: "Too many attempts. Wait a few minutes and try again.",
        accountUnavailableError: "The account service is unavailable right now. Please try again later.",
        registerError: "We could not create your account. Please try again.",
        deniedTitle: "Access not authorized",
        deniedText: "You cannot continue because this site is restricted to people aged 21 or older.",
        review: "Review my answer",
        footer: "Laboratory research only · Not for human or veterinary use",
      },
    };

    const validFor = 30 * 24 * 60 * 60 * 1000;
    const storageKey = "lab_age_verified_at";
    const panel = gate.querySelector(".lab-age-gate__panel");
    const registerForm = gate.querySelector("[data-age-register-form]");
    const registerStatus = gate.querySelector("[data-age-register-status]");
    const registerSubmit = gate.querySelector("[data-age-register-submit]");
    const registerSubmitText = registerSubmit?.querySelector("[data-age-i18n]");
    const passwordInput = registerForm?.elements.namedItem("password");
    const passwordCount = gate.querySelector("[data-age-password-count]");
    const passwordProgress = gate.querySelector("[data-age-password-progress]");
    let lockedNodes = [];
    let previousOverflow = "";
    let isOpen = true;
    let registerBusy = false;
    let activeLanguage = "es";

    const getLanguage = () => {
      try {
        const saved = localStorage.getItem("lab_language");
        if (saved === "en" || saved === "es") return saved;
      } catch {}
      return navigator.language?.toLowerCase().startsWith("en") ? "en" : "es";
    };

    const hasValidAcceptance = () => {
      try {
        const acceptedAt = Number(localStorage.getItem(storageKey));
        const elapsed = Date.now() - acceptedAt;
        return acceptedAt > 0 && elapsed >= 0 && elapsed < validFor;
      } catch {
        return false;
      }
    };

    const applyLanguage = (nextLanguage = getLanguage(), notify = true) => {
      const language = nextLanguage === "en" ? "en" : "es";
      activeLanguage = language;
      document.documentElement.lang = language;
      try { localStorage.setItem("lab_language", language); } catch {}
      gate.querySelectorAll("[data-age-i18n]").forEach((element) => {
        const value = copy[language][element.dataset.ageI18n];
        if (value) element.textContent = value;
      });
      gate.querySelectorAll("[data-age-language]").forEach((button) => {
        const active = button.dataset.ageLanguage === language;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("is-active", active);
      });
      if (registerStatus?.dataset.copyKey && !registerStatus.hidden) {
        registerStatus.textContent = copy[language][registerStatus.dataset.copyKey] || "";
      }
      if (notify) window.dispatchEvent(new CustomEvent("lab:language-change", { detail: { language } }));
    };

    const clearRegisterStatus = () => {
      if (!registerStatus) return;
      registerStatus.hidden = true;
      registerStatus.textContent = "";
      registerStatus.removeAttribute("data-status");
      registerStatus.removeAttribute("data-copy-key");
      registerStatus.setAttribute("role", "status");
      registerStatus.setAttribute("aria-live", "polite");
    };

    const updatePasswordProgress = () => {
      const length = passwordInput?.value?.length || 0;
      const progress = Math.min(length, 10);
      if (passwordCount) passwordCount.textContent = `${length} / 10`;
      if (passwordProgress) {
        passwordProgress.setAttribute("aria-valuenow", String(progress));
        passwordProgress.classList.toggle("is-complete", length >= 10);
        const fill = passwordProgress.querySelector("span");
        if (fill) fill.style.width = `${progress * 10}%`;
      }
    };

    const setRegisterStatus = (copyKey, type = "error") => {
      if (!registerStatus) return;
      registerStatus.dataset.copyKey = copyKey;
      registerStatus.dataset.status = type;
      registerStatus.setAttribute("role", type === "error" ? "alert" : "status");
      registerStatus.setAttribute("aria-live", type === "error" ? "assertive" : "polite");
      registerStatus.textContent = copy[activeLanguage][copyKey] || copy[activeLanguage].registerError;
      registerStatus.hidden = false;
    };

    const setRegisterBusy = (busy) => {
      registerBusy = busy;
      registerForm?.setAttribute("aria-busy", String(busy));
      registerForm?.querySelectorAll("input, button").forEach((element) => { element.disabled = busy; });
      const backButton = gate.querySelector("[data-age-register-back]");
      if (backButton) backButton.disabled = busy;
      registerSubmit?.classList.toggle("is-busy", busy);
      if (registerSubmitText) {
        registerSubmitText.dataset.ageI18n = busy ? "registerBusy" : "registerSubmit";
        registerSubmitText.textContent = copy[activeLanguage][registerSubmitText.dataset.ageI18n];
      }
    };

    const lockPage = () => {
      if (!isOpen || hasValidAcceptance() || document.body.classList.contains("lab-age-gate-open")) return;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      document.body.classList.add("lab-age-gate-open");
      lockedNodes = Array.from(document.body.children).filter(
        (element) => element !== gate && !["SCRIPT", "STYLE"].includes(element.tagName)
      );
      lockedNodes.forEach((element) => {
        element.inert = true;
        element.setAttribute("aria-hidden", "true");
        element.setAttribute("data-lab-age-locked", "true");
      });
      requestAnimationFrame(() => panel?.focus({ preventScroll: true }));
    };

    const unlockPage = () => {
      document.querySelectorAll('[data-lab-age-locked="true"]').forEach((element) => {
        element.inert = false;
        element.removeAttribute("aria-hidden");
        element.removeAttribute("data-lab-age-locked");
      });
      document.body.style.overflow = previousOverflow;
      document.body.classList.remove("lab-age-gate-open");
      lockedNodes = [];
    };

    const showView = (view) => {
      gate.dataset.view = view;
      const labels = {
        verify: "lab-age-title",
        register: "lab-age-register-title",
        denied: "lab-age-denied-title",
      };
      gate.setAttribute("aria-labelledby", labels[view] || "lab-age-title");
      gate.querySelectorAll("[data-age-view]").forEach((element) => {
        element.hidden = element.dataset.ageView !== view;
      });
      panel?.scrollTo({ top: 0 });
      requestAnimationFrame(() => {
        const target = view === "register"
          ? gate.querySelector("#lab-age-register-title")
          : view === "denied"
            ? gate.querySelector("#lab-age-denied-title")
            : gate.querySelector("[data-age-accept]");
        target?.focus({ preventScroll: true });
      });
    };

    const accept = (redirectTo = "") => {
      isOpen = false;
      try { localStorage.setItem(storageKey, String(Date.now())); } catch {}
      document.documentElement.dataset.labAgeValid = "true";
      window.dispatchEvent(new CustomEvent("lab:age-accepted"));
      gate.classList.add("is-leaving");
      window.setTimeout(() => {
        gate.hidden = true;
        gate.setAttribute("aria-hidden", "true");
        unlockPage();
        if (redirectTo) window.location.assign(redirectTo);
      }, 180);
    };

    const registerErrorKeys = {
      EMAIL_EXISTS: "emailExistsError",
      INVALID_REGISTRATION: "invalidRegistrationError",
      INVALID_FIELDS: "invalidRegistrationError",
      INVALID_EMAIL: "invalidEmailStatus",
      WEAK_PASSWORD: "passwordStatus",
      AGE_REQUIRED: "consentStatus",
      RATE_LIMITED: "rateLimitedError",
      ACCOUNT_API_NOT_CONFIGURED: "accountUnavailableError",
      ACCOUNT_API_UNAVAILABLE: "accountUnavailableError",
    };

    const submitRegister = async (event) => {
      event.preventDefault();
      if (!registerForm || registerBusy) return;

      clearRegisterStatus();
      registerForm.querySelectorAll("[aria-invalid='true']").forEach((element) => element.removeAttribute("aria-invalid"));

      const firstNameInput = registerForm.elements.namedItem("first_name");
      const lastNameInput = registerForm.elements.namedItem("last_name");
      const emailInput = registerForm.elements.namedItem("email");
      const consentInput = registerForm.elements.namedItem("age_confirmed");
      const firstName = firstNameInput?.value.trim() || "";
      const lastName = lastNameInput?.value.trim() || "";
      const email = emailInput?.value.trim() || "";
      const password = passwordInput?.value || "";

      let invalidInput = null;
      let validationKey = "";
      if (!firstName) {
        invalidInput = firstNameInput;
        validationKey = "requiredStatus";
      } else if (!lastName) {
        invalidInput = lastNameInput;
        validationKey = "requiredStatus";
      } else if (!email || !emailInput?.checkValidity()) {
        invalidInput = emailInput;
        validationKey = email ? "invalidEmailStatus" : "requiredStatus";
      } else if (password.length < 10) {
        invalidInput = passwordInput;
        validationKey = "passwordStatus";
      } else if (!consentInput?.checked) {
        invalidInput = consentInput;
        validationKey = "consentStatus";
      }

      if (validationKey) {
        invalidInput?.setAttribute("aria-invalid", "true");
        setRegisterStatus(validationKey);
        invalidInput?.focus({ preventScroll: true });
        return;
      }

      setRegisterBusy(true);
      try {
        const response = await fetch("/api/account/register", {
          method: "POST",
          credentials: "same-origin",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            first_name: firstName,
            last_name: lastName,
            email,
            password,
            age_confirmed: true,
            language: activeLanguage,
          }),
        });
        const payload = await response.json().catch(() => ({ ok: false, code: "INVALID_RESPONSE" }));
        if (!response.ok || payload?.ok === false) {
          const code = payload?.code || (response.status === 429 ? "RATE_LIMITED" : "DEFAULT");
          throw Object.assign(new Error(code), { code });
        }

        registerForm.reset();
        updatePasswordProgress();
        setRegisterBusy(false);
        setRegisterStatus("registerSuccess", "success");
        if (payload?.user) {
          window.dispatchEvent(new CustomEvent("lab:account-session", { detail: { user: payload.user } }));
        }
        window.setTimeout(() => accept("/cuenta"), 520);
      } catch (error) {
        setRegisterBusy(false);
        const errorKey = registerErrorKeys[error?.code] || "registerError";
        setRegisterStatus(errorKey);
      }
    };

    applyLanguage();
    if (hasValidAcceptance()) {
      isOpen = false;
      gate.hidden = true;
      gate.setAttribute("aria-hidden", "true");
      return;
    }

    try { localStorage.removeItem(storageKey); } catch {}
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", lockPage, { once: true });
    else lockPage();

    gate.querySelector("[data-age-accept]")?.addEventListener("click", () => accept());
    gate.querySelector("[data-age-deny]")?.addEventListener("click", () => showView("denied"));
    gate.querySelector("[data-age-review]")?.addEventListener("click", () => showView("verify"));
    gate.querySelector("[data-age-register-open]")?.addEventListener("click", () => {
      clearRegisterStatus();
      showView("register");
    });
    gate.querySelector("[data-age-register-back]")?.addEventListener("click", () => {
      if (registerBusy) return;
      clearRegisterStatus();
      showView("verify");
    });
    registerForm?.addEventListener("submit", submitRegister);
    passwordInput?.addEventListener("input", updatePasswordProgress);
    updatePasswordProgress();
    gate.querySelectorAll("[data-age-language]").forEach((button) => {
      button.addEventListener("click", () => applyLanguage(button.dataset.ageLanguage));
    });
    window.addEventListener("lab:language-change", (event) => {
      const language = event.detail?.language;
      if ((language === "es" || language === "en") && language !== activeLanguage) applyLanguage(language, false);
    });
    window.addEventListener("storage", (event) => {
      if (event.key === "lab_language" && (event.newValue === "es" || event.newValue === "en")) {
        applyLanguage(event.newValue, false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (!isOpen) return;
      if (event.key === "Escape") {
        event.preventDefault();
        return;
      }
      if (event.key !== "Tab") return;
      const focusable = Array.from(gate.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'))
        .filter((element) => !element.closest("[hidden]") && element.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  })();
</script>

<style is:global>
  html[data-lab-age-valid="true"] .lab-age-gate { display: none; }

  .lab-age-gate {
    position: fixed;
    inset: 0;
    z-index: 90000;
    display: grid;
    place-items: center;
    overflow-y: auto;
    padding: 18px;
    background: rgba(1, 5, 15, 0.92);
    color: #f8fafc;
    opacity: 1;
    transition: opacity 180ms ease, visibility 180ms ease;
  }

