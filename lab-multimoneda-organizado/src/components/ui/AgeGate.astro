<script is:inline>
  (() => {
    try {
      const acceptedAt = Number(localStorage.getItem("lab_age_verified_at"));
      const elapsed = Date.now() - acceptedAt;
      if (acceptedAt > 0 && elapsed >= 0 && elapsed < 30 * 24 * 60 * 60 * 1000) {
        document.documentElement.dataset.labAgeValid = "true";
      }
    } catch {}
  })();
</script>

